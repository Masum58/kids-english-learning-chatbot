# Database Configuration
# Local Docker: postgresql+psycopg://chatbot:chatbot@localhost:5432/chatbot
# Cloud (Render / Neon / Supabase): postgresql://user:password@host:port/dbname?sslmode=require
# Note: The app automatically normalizes "postgres://" and "postgresql://" to use psycopg3.
DATABASE_URL=postgresql+psycopg://chatbot:chatbot@localhost:5432/chatbot

# Google Gemini API Key
# Get a free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Configuration
# gemini-3.5-flash-lite is recommended for ultra-low latency (<500ms)
GEMINI_MODEL=gemini-3.5-flash-lite

# LLM Request Timeout (seconds)
# Strict timeout ensures all responses stay well below the 2.0-second SLA.
# If Gemini takes longer or is unavailable, the system safely falls back to SEL templates.
LLM_TIMEOUT_SECONDS=1.3